{
  description = "{{ project_name }}";

  # graft (https://github.com/danielnaab/graft/tree/v2) copies pinned exports of the docs this project
  # follows into scions/: `nix run .#graft`, then commit scions/. `nix flake check` fails if scions/
  # drifts from flake.lock. `nix run .#graft -- upgrade` moves graft itself, its workflows and each
  # tag-pinned scion to the newest tag in its major; the weekly bot does the same as a PR.
  inputs.graft.url = "github:danielnaab/graft/v2.9.0";
  inputs.knowledge-base-kit = {
    url = "github:danielnaab/knowledge-base-kit/v2.0.0";
    flake = false;
  };
  # The python-kit commit this project was generated or last updated from: python-kit-upgrade moves
  # it with each update (after a manual `copier update`, set it to the new tag's commit), so the
  # pattern docs in scions/ match the template the code came from. This file is the project's:
  # `copier update` doesn't touch it.
  inputs.python-kit = {
    url = "github:danielnaab/python-kit/{{ _copier_conf.vcs_ref_hash }}";
    flake = false;
  };

  outputs = inputs: inputs.graft.lib.mkFlake { inherit inputs; };
}
