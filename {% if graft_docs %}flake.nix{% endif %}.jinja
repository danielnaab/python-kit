{
  description = "{{ project_name }}";

  # graft (https://github.com/danielnaab/graft/tree/v2) copies pinned exports of the docs this project
  # follows into scions/: `nix run .#graft`, then commit scions/. `nix flake check` fails if scions/
  # drifts from flake.lock. `nix run .#graft-upgrade` moves graft itself, its workflows and each
  # tag-pinned scion to the newest tag in its major; the weekly bot does the same as a PR.
  inputs.graft.url = "github:danielnaab/graft/v2.4.1";
  inputs.meta-knowledge-base = {
    url = "github:danielnaab/meta-knowledge-base/v1.0.1";
    flake = false;
  };
  # The python-starter commit this project was generated or last updated from: `copier update`
  # moves it, so the pattern docs in scions/ always match the template the code came from.
  inputs.python-starter = {
    url = "github:danielnaab/python-starter/{{ _copier_conf.vcs_ref_hash }}";
    flake = false;
  };

  outputs = inputs: inputs.graft.lib.mkGraft {
    inherit inputs;
    deps = [ "meta-knowledge-base" "python-starter" ];
  };
}
