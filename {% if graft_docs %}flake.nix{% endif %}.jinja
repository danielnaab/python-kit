{
  description = "{{ project_name }}";

  # graft (https://github.com/danielnaab/graft) grafts the docs this project follows into scions/ as git
  # submodules, each at a release tag: scions/python-kit (the pattern docs, at the python-kit version
  # this project was generated or last updated from) and scions/knowledge-base-kit. The submodule
  # commit is the pin; this file names no scion. Empty scions/ folders after a clone:
  # `git submodule update --init` (or `nix run .#graft sync`). `nix run .#graft check` fails until
  # every scion is clean and at a release tag; `nix run .#graft upgrade` moves graft and each scion to
  # the newest tag in its major, and the weekly bot does the same as a PR. python-kit-upgrade moves
  # scions/python-kit with each `copier update`. This file is the project's: `copier update` doesn't
  # touch it.
  inputs.self.submodules = true;  # Nix >= 2.27: the flake's source includes the scions
  inputs.graft.url = "github:danielnaab/graft/v2.13.1";

  outputs = inputs: inputs.graft.lib.mkFlake { inherit inputs; };
}
